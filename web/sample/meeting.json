     "name": "queries.sql"
    }
   ]
  },
  {
   "id": "utt:mtg:knadh/listmonk:listmonk-handover-campaign-manager-and-config-20261020#0022",
   "meeting_id": "mtg:knadh/listmonk:listmonk-handover-campaign-manager-and-config-20261020",
   "seq": 22,
   "text": "dependencies के बारे में कुछ जो Priya को पता होना चाहिए?",
