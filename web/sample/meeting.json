  },
  {
   "id": "utt:mtg:knadh/listmonk:listmonk-handover-campaign-manager-and-config-20261020#0023",
   "meeting_id": "mtg:knadh/listmonk:listmonk-handover-campaign-manager-and-config-20261020",
   "seq": 23,
   "text": "Database driver के लिए हम github.com/lib/pq ही use करते हैं। pgx पे switch करने का plan था पर हमने नहीं किया क्योंकि sqlx के साथ lib/pq stable है और कोई performance issue नहीं था। HTTP के लिए github.com/labstack/echo/v4 है, config के लिए github.com/knadh/koanf।",
   "text_en": null,
   "start_ms": 247000,
   "end_ms": 266000,
   "speaker_label": "S1",
   "speaker": {
    "id": "person:email:rohan.mehta@example.com",
    "name": "Rohan Mehta"
   },
   "language": "hi-IN",
   "mentions": [
    {
     "id": "dep:knadh/listmonk:go:github.com/lib/pq",
     "label": "Dependency",
     "name": "github.com/lib/pq"
    },
    {
     "id": "dep:knadh/listmonk:go:github.com/knadh/koanf",
     "label": "Dependency",
     "name": "github.com/knadh/koanf"
