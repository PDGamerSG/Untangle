   },
   "language": "hi-IN",
   "mentions": []
  },
  {
   "id": "utt:mtg:knadh/listmonk:listmonk-handover-campaign-manager-and-config-20261020#0019",
   "meeting_id": "mtg:knadh/listmonk:listmonk-handover-campaign-manager-and-config-20261020",
   "seq": 19,
   "text": "cmd/ में सारे HTTP handlers हैं, cmd/campaigns.go में campaign के endpoints हैं। internal/manager/manager.go campaign runner है, वही workers spawn करता है और messages बनाता है। internal/messenger में SMTP और postback messengers हैं।",
   "text_en": null,
   "start_ms": 198000,
   "end_ms": 214000,
   "speaker_label": "S1",
   "speaker": {
    "id": "person:email:rohan.mehta@example.com",
    "name": "Rohan Mehta"
   },
   "language": "hi-IN",
   "mentions": [
    {
