   },
   "language": "hi-IN",
   "mentions": [
    {
     "id": "cfg:knadh/listmonk:schema.sql::app.max_send_errors",
     "label": "ConfigKey",
     "name": "app.max_send_errors"
    }
   ]
  },
  {
   "id": "utt:mtg:knadh/listmonk:listmonk-handover-campaign-manager-and-config-20261020#0011",
   "meeting_id": "mtg:knadh/listmonk:listmonk-handover-campaign-manager-and-config-20261020",
   "seq": 11,
   "text": "max_send_errors को 1000 रखा है ताकि एक गलत SMTP config पूरी list burn ना करे, 1000 से ज़्यादा send errors पे manager campaign को pause कर देता है।",
   "text_en": null,
   "start_ms": 109000,
   "end_ms": 125000,
   "speaker_label": "S1",
   "speaker": {
    "id": "person:email:rohan.mehta@example.com",
    "name": "Rohan Mehta"
   },
   "language": "hi-IN",
   "mentions": [
    {
     "id": "cfg:knadh/listmonk:schema.sql::app.max_send_errors",
     "label": "ConfigKey",
     "name": "app.max_send_errors"
    }
   ]
  },
  {
   "id": "utt:mtg:knadh/listmonk:listmonk-handover-campaign-manager-and-config-20261020#0012",
   "meeting_id": "mtg:knadh/listmonk:listmonk-handover-campaign-manager-and-config-20261020",
   "seq": 12,
   "text": "ये SMTP settings कहाँ हैं, [smtp] block में?",
   "text_en": null,
   "start_ms": 126000,
   "end_ms": 130000,
   "speaker_label": "S2",
   "speaker": {
    "id": "person:email:priya.nair@example.com",
    "name": "Priya Nair"
   },
   "language": "hi-IN",
   "mentions": []
  },
  {
   "id": "utt:mtg:knadh/listmonk:listmonk-handover-campaign-manager-and-config-20261020#0013",
   "meeting_id": "mtg:knadh/listmonk:listmonk-handover-campaign-manager-and-config-20261020",
   "seq": 13,
   "text": "हाँ, config.toml में [smtp] block है, वहाँ max_conns और max_msg_retries हैं। max_msg_retries 2 ही रहने दो, ज़्यादा retries से duplicate deliveries का risk है।",
   "text_en": null,
   "start_ms": 131000,
   "end_ms": 145000,
   "speaker_label": "S1",
   "speaker": {
    "id": "person:email:rohan.mehta@example.com",
    "name": "Rohan Mehta"
   },
   "language": "hi-IN",
   "mentions": [
    {
     "id": "cfg:knadh/listmonk:config.toml.sample::smtp.my0.max_conns",
     "label": "ConfigKey",
     "name": "smtp.my0.max_conns"
    },
    {
     "id": "cfg:knadh/listmonk:config.toml.sample::smtp.my0.max_msg_retries",
