    }
   ]
  },
  {
   "id": "utt:mtg:knadh/listmonk:listmonk-handover-campaign-manager-and-config-20261020#0018",
   "meeting_id": "mtg:knadh/listmonk:listmonk-handover-campaign-manager-and-config-20261020",
   "seq": 18,
   "text": "Good. अब code structure, Priya के लिए।",
   "text_en": null,
   "start_ms": 193000,
   "end_ms": 197000,
   "speaker_label": "S3",
   "speaker": {
    "id": "person:email:arjun.rao@example.com",
