# ---- Neo4j (local Docker by default; AuraDB works with the neo4j+s:// URI from the Aura console) ----
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=untangle-dev-password
# Aura Free exposes exactly one database, normally "neo4j". Leave empty for the server default.
NEO4J_DATABASE=

# ---- GitHub ingestion ----
# A token with public_repo scope raises the API limit from 60 to 5000 requests/hour. `gh auth token` prints yours.
GITHUB_TOKEN=
# Where cloned repositories are kept (untrusted data: never executed, only read).
UNTANGLE_REPO_CACHE=.cache/repos

# ---- Language model for composing answers and extracting decisions ----
# fake | anthropic | sarvam | openai  (fake renders template answers from the graph: the demo works without any key)
LLM_BACKEND=fake
LLM_MODEL=
ANTHROPIC_API_KEY=
SARVAM_API_KEY=
OPENAI_API_KEY=
OPENAI_BASE_URL=

# ---- Embeddings for the vector-only baseline and chunk search ----
# fastembed | fake   (fastembed downloads BAAI/bge-small-en-v1.5, 384 dims, ~130 MB, CPU only)
EMBED_BACKEND=fake
EMBED_MODEL=BAAI/bge-small-en-v1.5
EMBED_DIM=384

# ---- Sarvam speech-to-text for handover (KT) recordings ----
SARVAM_STT_MODEL=saaras:v4
SARVAM_STT_MODE=codemix

# ---- API / web ----
API_HOST=127.0.0.1
API_PORT=8090
CORS_ORIGINS=http://localhost:3000
NEXT_PUBLIC_UNTANGLE_API=http://localhost:8090
