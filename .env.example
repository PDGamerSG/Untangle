# ---- Neo4j (local Docker by default; AuraDB works with the neo4j+s:// URI from the Aura console) ----
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=untangle-dev-password
# Aura Free exposes exactly one database, normally "neo4j". Leave empty for the server default.
NEO4J_DATABASE=

# ---- GitHub ingestion ----
# A token with public_repo scope raises the API limit from 60 to 5000 requests/hour. `gh auth token` prints yours.
GITHUB_TOKEN=
# Where cloned repositories are kept (untrusted data: never executed, only read).
UNTANGLE_REPO_CACHE=.cache/repos
# Writable model / embedding cache; defaults to /tmp/untangle on Vercel.
# UNTANGLE_CACHE_DIR=.cache

# Optional custom Cypher query directory. Unset uses checkout or bundled wheel queries.
# UNTANGLE_CYPHER_DIR=./cypher

# ---- Language model for composing answers and extracting decisions ----
# Production uses Claude only. Set fake explicitly for offline fixture tests.
LLM_BACKEND=anthropic
LLM_MODEL=
ANTHROPIC_API_KEY=
SARVAM_API_KEY=

# ---- Embeddings for the vector-only baseline and chunk search ----
# fastembed | fake   (free BAAI/bge-small-en-v1.5, 384 dims, ~64 MB, CPU only; no API key)
EMBED_BACKEND=fastembed
EMBED_MODEL=BAAI/bge-small-en-v1.5
EMBED_DIM=384

# ---- Sarvam speech-to-text for handover (KT) recordings ----
SARVAM_STT_MODEL=saaras:v4
SARVAM_STT_MODE=codemix

# ---- API / web ----
# Put NEXT_PUBLIC_* values in web/.env.local when running the Next.js client.
API_HOST=127.0.0.1
API_PORT=8090
CORS_ORIGINS=http://localhost:3000
# Set these in web/.env.local, not in this backend file.
# UNTANGLE_API_URL=http://127.0.0.1:8090
# NEXT_PUBLIC_UNTANGLE_API=/api
