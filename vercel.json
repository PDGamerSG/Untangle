{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "regions": ["bom1"],
  "services": {
    "api": {
      "root": ".",
      "framework": "fastapi",
      "entrypoint": "app:app",
      "functions": {
        "app.py": {
          "maxDuration": 300,
          "excludeFiles": "{web/**,landing/**,tests/**,docs/**,eval/**,.cache/**,.venv/**,.claude/**,landing-preview.png}"
        }
      }
    },
    "web": {
      "root": "web",
      "framework": "nextjs",
      "installCommand": "pnpm install --frozen-lockfile",
      "buildCommand": "pnpm build"
    }
  },
  "rewrites": [
    {
      "source": "/(.*)",
      "has": [{"type": "host", "value": "untangle-code-api.vercel.app"}],
      "destination": {"service": "api"}
    },
    {"source": "/api/:path*", "destination": {"service": "api"}},
    {"source": "/(.*)", "destination": {"service": "web"}}
  ]
}
